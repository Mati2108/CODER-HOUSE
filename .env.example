# Copiá este archivo como ".env" y completá tus valores reales.
# El .env NO se sube a GitHub (está en .gitignore).

# Proveedor a usar: "openai", "anthropic" o "gemini"
PROVIDER=gemini

# API key de OpenAI  -> https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-tu-key-de-openai

# API key de Anthropic -> https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-tu-key-de-anthropic

# API key de Gemini (tiene capa GRATUITA) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=tu-key-de-gemini
